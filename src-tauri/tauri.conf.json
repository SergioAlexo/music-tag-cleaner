{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicTagCleaner",
  "version": "0.19.1",
  "identifier": "com.sopas.musictagcleaner",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs --debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MusicTagCleaner",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/mtc-mcp"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "ogg",
          "aac",
          "m4a",
          "wav",
          "aiff",
          "aif"
        ],
        "name": "MusicTagCleaner Audio",
        "description": "Audio file",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sergioalexo/music-tag-cleaner/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyRThEMDlCODFCMjhDMTgKUldRWWpMS0JtOURvb20rUitXakNWb0lFY3JxYytScTJWRlo3VXZCZ1RPdW5hYnJSTjlYYVpBWEwK"
    }
  }
}
